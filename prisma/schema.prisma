datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  role          String    @default("user")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  subscriptions Subscription[]
  payments      Payment[]
  generatorUses GeneratorUse[]

  @@map("users")
}

model Subscription {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  status        String    @default("active")
  startDate     DateTime  @default(now())
  endDate       DateTime
  autoRenew     Boolean   @default(true)
  paymentId     String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("subscriptions")
}

model Payment {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  kassaId       String    @unique
  amount        Float
  currency      String    @default("RUB")
  status        String

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("payments")
}

model Segment {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String

  subjects  Subject[]
  topics    Topic[]

  @@map("segments")
}

model Subject {
  id        String    @id @default(cuid())
  slug      String
  name      String
  icon      String?

  segmentId String
  segment   Segment   @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  topics    Topic[]

  @@unique([slug, segmentId])
  @@map("subjects")
}

model Topic {
  id          String    @id @default(cuid())
  slug        String
  title       String
  description String?

  segmentId   String
  segment     Segment   @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  formats     Format[]

  @@unique([slug, subjectId, segmentId])
  @@map("topics")
}

model Format {
  id        String    @id @default(cuid())
  type      String
  content   String?
  isPublic  Boolean   @default(true)
  isPaid    Boolean   @default(false)

  topicId   String
  topic     Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())

  @@unique([topicId, type])
  @@map("formats")
}

model GeneratorUse {
  id        String    @id @default(cuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  sessionId String?
  type      String

  createdAt DateTime  @default(now())

  @@map("generator_uses")
}

model PageView {
  id        String    @id @default(cuid())
  url       String
  userId    String?

  createdAt DateTime  @default(now())

  @@map("page_views")
}
