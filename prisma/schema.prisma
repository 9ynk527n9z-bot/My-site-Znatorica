datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  role          String    @default("user")
  emailConfirmed Boolean  @default(false)
  emailConfirmedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  starsBalance    Int       @default(0) // бонусные звёзды (например, за ежедневный подарок)
  lastDailyGiftAt DateTime?
  dailyGiftStreak Int       @default(0)

  subscriptions Subscription[]
  payments      Payment[]
  purchases     Purchase[]
  tournamentResults TournamentResult[]
  generatorUses GeneratorUse[]
  consents      UserConsent[]
  verificationCodes EmailVerificationCode[]
  passwordResetCodes PasswordResetCode[]
  decorations   UserDecoration[]

  @@map("users")
}

// Купленные украшения для «Домика Знатика» (геймификация) — за звёзды.
// itemId ссылается на каталог в lib/decorations.ts (не отдельная таблица —
// каталог редактируется в коде, а не через админку, менять его дёшево).
model UserDecoration {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId      String
  purchasedAt DateTime @default(now())

  @@unique([userId, itemId])
  @@map("user_decorations")
}

model Subscription {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan          String    @default("monthly") // 'monthly' | 'lifetime'
  status        String    @default("active")
  startDate     DateTime  @default(now())
  endDate       DateTime
  autoRenew     Boolean   @default(true)
  paymentId     String?
  paymentMethodId String? // сохранённый способ оплаты ЮKassa (payment_method.id) для автосписания при продлении
  renewalReminderSentAt DateTime? // когда отправили письмо-напоминание о скором окончании подписки

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("subscriptions")
}

model Payment {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  kassaId       String    @unique
  amount        Float
  currency      String    @default("RUB")
  status        String

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("payments")
}

// Разовая покупка PDF-сборника (не подписка) — каталог продуктов задан статично
// в lib/products.ts, тут только факт покупки для проверки доступа к скачиванию.
model Purchase {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  productSlug   String
  paymentId     String

  createdAt     DateTime  @default(now())

  @@unique([userId, productSlug])
  @@map("purchases")
}

// Результат прохождения «Турнира Знатоков» — участие всегда бесплатно, платный
// только именной PDF-диплом с результатом (см. metadata.type: 'tournament' в
// payments/create). До оплаты запись существует, но paid: false — диплом не выдаётся.
model TournamentResult {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  trackId     String    // напр. "1-klass/matematika"
  trackTitle  String    // денормализовано для диплома, напр. "1 класс · Математика"
  childName   String
  score       Int
  total       Int

  paid        Boolean   @default(false)
  paymentId   String?

  createdAt   DateTime  @default(now())

  @@map("tournament_results")
}

model Segment {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String

  subjects  Subject[]
  topics    Topic[]

  @@map("segments")
}

model Subject {
  id        String    @id @default(cuid())
  slug      String
  name      String
  icon      String?

  segmentId String
  segment   Segment   @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  topics    Topic[]

  @@unique([slug, segmentId])
  @@map("subjects")
}

model Topic {
  id          String    @id @default(cuid())
  slug        String
  title       String
  description String?

  segmentId   String
  segment     Segment   @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  formats     Format[]

  @@unique([slug, subjectId, segmentId])
  @@map("topics")
}

model Format {
  id        String    @id @default(cuid())
  type      String
  content   String?
  isPublic  Boolean   @default(true)
  isPaid    Boolean   @default(false)

  topicId   String
  topic     Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())

  @@unique([topicId, type])
  @@map("formats")
}

model GeneratorUse {
  id        String    @id @default(cuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  sessionId String?
  type      String

  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@map("generator_uses")
}

model PageView {
  id        String    @id @default(cuid())
  url       String
  userId    String?
  sessionId String?   // анонимный идентификатор из cookie znatorika_sid (без привязки к личности)
  utmSource String?   // метка источника (?utm_source=... или yclid/gclid → yandex-direct/google-ads)
  referrer  String?   // document.referrer при заходе — хост сайта-источника (yandex.ru, google.com...)
  isBot     Boolean   @default(false) // похоже на бота/сканер по User-Agent — исключается из живой статистики
  isOwner   Boolean   @default(false) // визит залогиненного администратора сайта — исключается из статистики

  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@map("page_views")
}

model SearchQuery {
  id            String    @id @default(cuid())
  query         String
  resultsCount  Int
  sessionId     String?   // анонимный идентификатор из cookie znatorika_sid, если есть

  createdAt     DateTime  @default(now())

  @@index([createdAt])
  @@map("search_queries")
}

model EmailVerificationCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  code      String
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime  @default(now())

  @@map("email_verification_codes")
}

model PasswordResetCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  code      String
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime  @default(now())

  @@map("password_reset_codes")
}

model Setting {
  key       String    @id
  value     String
  updatedAt DateTime  @updatedAt

  @@map("settings")
}

// Редактируемый контент сайта: статьи для родителей и НОВЫЕ темы, создаваемые
// через админку. 52 старые «цветные» темы остаются в коде и здесь НЕ хранятся.
// Источник правды в рантайме — эта таблица; я (Claude) правлю тот же контент
// через prisma/content-seed.json, который на деплое доливается сюда по (kind, slug),
// НО пропускает строки с manualEdit=true — ручная правка через админку побеждает.
model ContentPage {
  id          String   @id @default(cuid())
  kind        String   // 'article' | 'topic'
  slug        String
  title       String
  description String   @default("")

  // Организационные поля для тем (у статей — null)
  segment     String?
  subject     String?

  // Поля статей (у тем обычно null)
  tag         String?
  readTime    String?
  date        String?  // YYYY-MM-DD — дата публикации статьи

  intro       String   @default("")
  body        Json     // [{ heading: string, body: string[] }]
  related     Json?    // [{ title: string, url: string }]

  published   Boolean  @default(true)
  manualEdit  Boolean  @default(false) // true → seed на деплое НЕ трогает эту запись

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([kind, slug])
  @@map("content_pages")
}

// Журнал действий администратора — подотчётность по ФЗ-152 (особенно действия
// с персональными данными: просмотр/экспорт/удаление пользователей).
model AdminLog {
  id         String   @id @default(cuid())
  adminId    String?
  adminEmail String
  action     String   // 'content.create' | 'content.update' | 'content.delete' | 'user.export' | 'user.delete' | ...
  entity     String   // 'content' | 'user' | 'payment' | 'settings'
  entityId   String?
  detail     String?  // краткое человекочитаемое описание
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@map("admin_logs")
}

// Отзывы посетителей сайта — публикуются ТОЛЬКО после модерации админом
// (status по умолчанию "pending"). Анонимно: name/email необязательны.
model Feedback {
  id          String    @id @default(cuid())
  name        String?
  email       String?
  message     String
  rating      Int?

  status      String    @default("pending") // 'pending' | 'approved' | 'rejected'
  moderatedAt DateTime?
  moderatedBy String?   // email админа, принявшего решение

  createdAt   DateTime  @default(now())

  @@index([status, createdAt])
  @@map("feedback")
}

model UserConsent {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  policyVersion       String    @default("1.0")
  consentedAt         DateTime  @default(now())
  emailConfirmedAt    DateTime?
  revokedAt           DateTime?

  ipHashAuth          String?   // Хеш IP при согласии
  ipHashEmail         String?   // Хеш IP при подтверждении email

  consentType         String    @default("general") // general, payment, marketing
  isActive            Boolean   @default(false)     // true только после email подтверждения

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("user_consents")
}
