# Шаблон переменных окружения для продакшен-сервера.
# Скопировать в .env.production на сервере и заполнить реальными значениями.
# Этот файл (.env.production.example) можно коммитить в git — в нём нет секретов.
# Сам .env.production — НИКОГДА не коммитить.

# База данных — контейнер db из docker-compose.yml, доступен приложению как хост "db"
POSTGRES_PASSWORD="сгенерировать-случайный-пароль-20+ символов"
DATABASE_URL="postgresql://znatorika:сгенерировать-случайный-пароль-20+ символов@db:5432/znatorika"

# JWT — случайная строка, генерируется один раз командой: openssl rand -hex 32
JWT_SECRET=""

# Адрес сайта (после настройки домена и SSL)
NEXT_PUBLIC_SITE_URL="https://znatorica.ru"

# YuKassa — реальные данные из личного кабинета yookassa.ru
YOOKASSA_SHOP_ID=""
YOOKASSA_API_KEY=""

# Шифрование персональных данных (ФЗ-152) — openssl rand -hex 32
DATA_ENCRYPTION_KEY=""

# Код подтверждения для удаления данных пользователя — любая случайная строка
DATA_DELETION_CODE=""

# Email для запросов по персональным данным
PRIVACY_EMAIL="privacy@znatorica.ru"

# SMTP — российский провайдер (Яндекс 360 для бизнеса / Mail.ru для бизнеса)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Знаторика <noreply@znatorica.ru>"
